{
  "name": "lucy-desktop-assistant",
  "version": "0.1.0",
  "description": "L.U.C.Y. - Autonomous Personal Desktop Assistant and Fantasy-Creature Companion",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build:worker": "node src/tools/native-uia/build-worker.js --force",
    "provision:whisper": "node scripts/provision-whisper.js",
    "verify:whisper": "node scripts/provision-whisper.js --verify-only",
    "package:dir": "npm run build:worker && npm run provision:whisper && electron-builder --win --dir",
    "package:installer": "npm run build:worker && npm run provision:whisper && electron-builder --win nsis",
    "package:portable": "npm run build:worker && npm run provision:whisper && electron-builder --win portable",
    "dist": "npm run build:worker && npm run provision:whisper && electron-builder --win nsis portable",
    "release": "node scripts/release-pipeline.js",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "release:verify": "node scripts/verify-release-artifacts.js",
    "smoke:packaged": "node scripts/smoke-test-packaged-app.js",
    "test:env": "node scripts/verify-environment.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/core/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "test:flow": "node --test tests/flow/*.test.js",
    "test:packaging": "node --test tests/packaging/*.test.js",
    "test:desktop": "node --test tests/desktop/*.test.js",
    "postinstall": "node scripts/patch-electron-builder.js"
  },
  "keywords": [
    "desktop-assistant",
    "ai-agent",
    "lucy",
    "jarvis",
    "electron"
  ],
  "author": "L.U.C.Y. Contributors",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.15.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
