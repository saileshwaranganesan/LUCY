# L.U.C.Y. - Safe Environment Variables Template
# NEVER commit your real .env file or credentials to source control.
# Real credentials can also be securely stored in Windows Credential Manager / DPAPI.

# AI Provider Configuration (Default: gemini, openrouter, or ollama)
# Available providers: gemini, openrouter, deepseek, ollama, custom-openai
LUCY_AI_PROVIDER=gemini
LUCY_AI_MODEL=gemini-2.0-flash

# API Keys (Leave blank if using local Ollama or when configured via Windows DPAPI)
LUCY_GEMINI_API_KEY=
LUCY_OPENROUTER_API_KEY=
LUCY_DEEPSEEK_API_KEY=

# Local Model Endpoint (e.g., Ollama or vLLM)
LUCY_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Security & Permissions
# Permission modes: strict (prompt for all actions), standard (confirm consequential), autonomous (within sandbox)
LUCY_PERMISSION_MODE=standard
# Dry-run mode: intercepts all tool actions and prevents side effects
LUCY_DRY_RUN=false

# Assistant Workspace Boundary (Absolute path to permitted working directory)
LUCY_WORKSPACE_DIR=C:\Users\admin\Desktop\LUCY
